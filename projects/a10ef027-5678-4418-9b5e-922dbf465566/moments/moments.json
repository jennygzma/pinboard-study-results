    "startS": 1140.9,
    "endS": 1150.9,
    "kind": "interview",
    "relevance": "",
    "notes": "I think that it's so easy to desire so many things, um, that we actually don't need.",
    "tags": [],
    "source": "manual",
    "starred": true,
    "excluded": false,
    "createdAt": "2026-09-18T06:07:21.113Z"
