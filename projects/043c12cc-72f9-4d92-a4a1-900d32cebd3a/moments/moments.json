    "videoName": "A001C004_240718BC",
    "startS": 133.5,
    "endS": 147.2,
    "kind": "interview",
    "relevance": "",
    "notes": "When you're kind to yourself, you are rolling with the punches. You are more open to be flexible with your designs, and you can end up with something that turns out way better than your original design.",
    "tags": [],
    "source": "manual",
    "starred": true,
    "excluded": false,
    "createdAt": "2026-10-04T21:14:46.985Z"
  },
