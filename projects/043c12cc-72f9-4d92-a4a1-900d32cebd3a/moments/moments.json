    "videoName": "A001C004_240718BC",
    "startS": 98,
    "endS": 107.6,
    "kind": "interview",
    "relevance": "",
    "notes": "But also, I really want people to be creative and be kind to themselves.",
    "tags": [],
    "source": "manual",
    "starred": true,
    "excluded": false,
    "createdAt": "2026-10-04T21:14:46.985Z"
